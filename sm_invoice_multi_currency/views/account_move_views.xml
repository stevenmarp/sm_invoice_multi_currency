<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Invoice Form View to add Company Currency Totals -->
    <record id="view_move_form_multi_currency" model="ir.ui.view">
        <field name="name">account.move.form.multi_currency</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_totals']" position="after">
                <field name="company_amount_untaxed" string="Untaxed Amount (Company)"
                       invisible="currency_id == company_currency_id" readonly="1"/>
                <field name="company_amount_tax" string="Tax (Company)"
                       invisible="currency_id == company_currency_id" readonly="1"/>
                <field name="company_amount_total" string="Total (Company)" class="oe_subtotal_footer_separator"
                       invisible="currency_id == company_currency_id" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='amount_residual']" position="after">
                <field name="company_amount_residual" string="Amount Due (Company)" class="oe_subtotal_footer_separator"
                       invisible="currency_id == company_currency_id or state == 'draft'" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Invoice/Bill Tree View to add Company Currency Total column -->
    <record id="view_invoice_tree_multi_currency" model="ir.ui.view">
        <field name="name">account.invoice.tree.multi_currency</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total_in_currency_signed'][@groups='base.group_multi_currency']" position="after">
                <field name="company_amount_total" string="Total (Company)" sum="Total" optional="hide" decoration-bf="1" groups="base.group_multi_currency"/>
            </xpath>
        </field>
    </record>
</odoo>
